{
  "name": "odoo-ts-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node scripts/check_egress.mjs && node --experimental-transform-types --import ./test/register.mjs --test \"src/**/*.test.ts\" && python3 test/filestore_export.py",
    "test:integration": "node --experimental-transform-types --import ./test/register.mjs --test src/orm/orm.check.ts",
    "test:views": "bash test/views.sh",
    "postinstall": "node scripts/latin1-deps.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
